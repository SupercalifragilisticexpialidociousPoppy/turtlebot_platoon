<?xml version="1.0" ?>
<!--
  Dummy wall : Robot Platoon project, Single-Robot Distance-Lock Simulation.

  A flat vertical panel that slides along the world X axis under velocity
  control, standing in for the lead robot during PD gain tuning.

  Driven by publishing geometry_msgs/Twist to /wall/cmd_vel, which is the same
  interface a real lead TurtleBot exposes, so the follower's controller does
  not need to change when the wall is swapped for Robot 1 later.

  Note gravity is disabled on the link. The wall floats at a fixed height
  instead of resting on the ground plane, which removes ground friction from
  the picture entirely. With friction in play, planar_move fights the contact
  solver at low speeds and the wall advances in visible stick-slip jerks,
  which would show up in your scan filter as motion that is not really there.
-->
<sdf version="1.6">
  <model name="dummy_wall">

    <static>false</static>

    <link name="wall_link">

      <!-- Floats; see note above. -->
      <gravity>0</gravity>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.5</iyy><iyz>0.0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <!--
        0.05 m thick, 1.0 m wide, 0.5 m tall.

        The width matters: 1.0 m seen from 1.0 m away subtends about 53 deg,
        comfortably wider than the filter's 30 deg window. The window therefore
        stays full of wall at every test distance, so `face` should track
        `sector` closely and bearing should sit near 0. If you narrow this
        panel, the wall will start falling out of the window at close range.
      -->
      <collision name="wall_collision">
        <geometry>
          <box><size>0.05 1.0 0.5</size></box>
        </geometry>
      </collision>

      <visual name="wall_visual">
        <geometry>
          <box><size>0.05 1.0 0.5</size></box>
        </geometry>
        <material>
          <ambient>0.7 0.15 0.15 1</ambient>
          <diffuse>0.9 0.25 0.25 1</diffuse>
        </material>
      </visual>

    </link>

    <!--
      planar_move takes a Twist and drives the model in the XY plane.
      Namespaced to /wall so it cannot collide with the robot's own /cmd_vel.

      publish_odom_tf is false and the odom frame is renamed: publishing a
      second frame called "odom" into /tf would clash with the TurtleBot's
      own odom frame and corrupt RViz.
    -->
    <plugin name="wall_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/wall</namespace>
      </ros>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>wall_odom</odometry_frame>
      <robot_base_frame>wall_link</robot_base_frame>
      <odometry_rate>20.0</odometry_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
    </plugin>

  </model>
</sdf>
